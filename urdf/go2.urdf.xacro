<?xml version="1.0"?>
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Import elements (base + legs + built-in sensors) -->
<xacro:include filename="$(find go2_description)/urdf/base/base.urdf.xacro"/>
<xacro:include filename="$(find go2_description)/urdf/base/leg.urdf.xacro"/>
<xacro:include filename="$(find go2_description)/urdf/sensors/imu.urdf.xacro"/>
<xacro:include filename="$(find go2_description)/urdf/sensors/camera.urdf.xacro"/>

<!-- Define a macro for the whole Go2 body (base + legs) -->
<xacro:macro name="go2" params="prefix">

    <!-- Leg Allocations -->
    <xacro:property name="leg_offset_x" value="0.1934"/>
    <xacro:property name="leg_offset_y" value="0.0465"/>
    <xacro:property name="leg_offset_z" value="0.0"/>

    <!-- Robot base -->
    <xacro:go2_base prefix="${prefix}"/>

    <!-- Legs: front/left flags select joint limits, inertia mirroring and meshes.
         All joint origins are pure translations (no rotation), matching the real robot. -->
    <xacro:go2_leg prefix="${prefix}FL_" parent="${prefix}base_link" front="true" reflect="false"
            x="${leg_offset_x}"   y="${leg_offset_y}"   z="${leg_offset_z}"/>
    <xacro:go2_leg prefix="${prefix}FR_" parent="${prefix}base_link" front="true" reflect="true"
            x="${leg_offset_x}"   y="-${leg_offset_y}"  z="${leg_offset_z}"/>
    <xacro:go2_leg prefix="${prefix}RL_" parent="${prefix}base_link" front="false" reflect="false"
            x="-${leg_offset_x}"  y="${leg_offset_y}"   z="${leg_offset_z}"/>
    <xacro:go2_leg prefix="${prefix}RR_" parent="${prefix}base_link" front="false" reflect="true"
            x="-${leg_offset_x}"  y="-${leg_offset_y}"  z="${leg_offset_z}"/>

    <!-- Built-in IMU. The go2_ prefix avoids clashing with external IMUs. -->
    <xacro:imu_sensor prefix="${prefix}go2_" parent="${prefix}base_link">
        <origin xyz="-0.02557 0 0.04232" rpy="0 0 0"/>
    </xacro:imu_sensor>

    <!-- Built-in front camera. The go2_ prefix avoids clashing with external
         cameras. -->
    <xacro:camera_sensor prefix="${prefix}go2_" parent="${prefix}base_link">
        <origin xyz="0.325 0 0.045" rpy="0 0 0"/>
    </xacro:camera_sensor>

    <!-- Unitree 4D LiDAR-L1. Frame names are fixed by the Go2 firmware,
         so no prefix is applied. -->
    <link name="utlidar_lidar"/>
    <joint name="base_to_utlidar_lidar" type="fixed">
        <parent link="${prefix}base_link"/>
        <child link="utlidar_lidar"/>
        <origin xyz="0.28945 0 -0.046825" rpy="0 2.8782 0"/>
    </joint>

    <!-- The L1 IMU axes are parallel to the L1 point cloud frame. -->
    <link name="utlidar_imu"/>
    <joint name="utlidar_lidar_to_utlidar_imu" type="fixed">
        <parent link="utlidar_lidar"/>
        <child link="utlidar_imu"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</xacro:macro>

</robot>
