<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hesai_sensor">

    <!-- Hesai Sensor Macro -->
    <xacro:macro name="hesai_sensor" params="parent *origin">

        <joint name="hesai_lidar_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="hesai_lidar_link"/>
            <xacro:insert_block name="origin" />
        </joint>

        <link name="hesai_lidar_link">
            <visual>
                <geometry>
                    <mesh filename="package://go2_description/meshes/sensors/hesai_XT16.dae" scale="1 1 1"/>
                </geometry>
                <material name="">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://go2_description/meshes/sensors/hesai_XT16.dae" scale="1 1 1"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.9"/>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <inertia ixx="0.00093" ixy="0.0" ixz="0.0" iyy="0.00093" iyz="0.0" izz="0.001"/>
            </inertial>
        </link>

        <gazebo reference="hesai_lidar_link">
            <sensor name='gpu_lidar' type='gpu_lidar'>
            <pose relative_to="hesai_lidar_link">0 0 0 0 0 0</pose>
            <topic>hesai_lidar_sensor</topic>
            <update_rate>20</update_rate>
            <gz_frame_id>hesai_lidar_link</gz_frame_id>
            <lidar>
                <scan>
                <horizontal>
                    <samples>450</samples> <!-- 900 -->
                    <resolution>1</resolution>
                    <min_angle>-3.141592</min_angle>
                    <max_angle>3.141592</max_angle>
                </horizontal>
                <vertical>
                    <samples>16</samples>
                    <resolution>1</resolution>
                    <min_angle>-0.261799</min_angle>
                    <max_angle>0.261799</max_angle>
                </vertical>
                </scan>
                <range>
                <min>0.2</min>
                <max>90.0</max>
                <resolution>0.02</resolution>
                </range>
            </lidar>
            <visualize>true</visualize>
            </sensor>
        </gazebo>


    </xacro:macro>
</robot>